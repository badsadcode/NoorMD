{
  "name": "noormd-vendor-build",
  "private": true,
  "description": "Builds the offline, self-contained editor bundle shipped in src/NoorMD/wwwroot/vendor. Run only when upgrading third-party web libraries; the output is committed so the .NET build needs no Node.js.",
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@toast-ui/editor": "3.2.2",
    "dompurify": "3.2.6",
    "@fontsource-variable/inter": "5.2.6",
    "prosemirror-commands": "1.5.0",
    "prosemirror-history": "1.3.0",
    "prosemirror-inputrules": "1.2.0",
    "prosemirror-keymap": "1.2.1",
    "prosemirror-model": "1.19.0",
    "prosemirror-state": "1.4.2",
    "prosemirror-transform": "1.7.1",
    "prosemirror-view": "1.30.1"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  },
  "overrides": {
    "prosemirror-model": "1.19.0",
    "prosemirror-view": "1.30.1",
    "prosemirror-state": "1.4.2",
    "prosemirror-transform": "1.7.1"
  }
}
