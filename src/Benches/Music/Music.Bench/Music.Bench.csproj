<Project Sdk="Microsoft.NET.Sdk">
  <!-- NoorMD 3.0: the Music bench (its interface: web files packed in the DLL; its logic: Music.Core). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Music.Bench</RootNamespace>
    <AssemblyName>Music.Bench</AssemblyName>
    <Version>3.0.12</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Noor.Contracts\Noor.Contracts.csproj" />
    <ProjectReference Include="..\Music.Core\Music.Core.csproj" />
    <EmbeddedResource Include="web\**" />
  </ItemGroup>
</Project>
