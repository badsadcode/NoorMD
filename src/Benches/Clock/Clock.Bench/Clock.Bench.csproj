<Project Sdk="Microsoft.NET.Sdk">
  <!-- NoorMD 3.0: the Clock, a small demo bench with panels to dock in other benches (a clock, a stopwatch).
       It goes away with the Sandbox when the real benches arrive. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Clock.Bench</RootNamespace>
    <AssemblyName>Clock.Bench</AssemblyName>
    <Version>3.0.14</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Noor.Contracts\Noor.Contracts.csproj" />
    <EmbeddedResource Include="web\**" />
  </ItemGroup>
</Project>
