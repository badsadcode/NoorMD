<Window x:Class="NoorMD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NoorMD"
        Icon="Assets/NoorMD.ico"
        Width="1360" Height="880" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}">
    <Grid>
        <wv2:WebView2 x:Name="Web" Visibility="Hidden" />

        <!-- Shown until the editor has rendered its first frame (no white flash), or when WebView2 is missing. -->
        <Grid x:Name="Splash" Background="{DynamicResource BgBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-5" />
                    </Border.RenderTransform>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#C5A7FF" Offset="0" />
                            <GradientStop Color="#766BE2" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="N." FontSize="26" FontWeight="Black" Foreground="#171026" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="SplashTitle" Text="NoorMD" FontFamily="{StaticResource UiFont}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock x:Name="SplashText" Text="Preparing your writing studio…" FontFamily="{StaticResource UiFont}" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="SplashAction" Visibility="Collapsed" Style="{StaticResource DialogPrimaryButton}" Margin="0,20,0,0"
                        HorizontalAlignment="Center" Click="SplashAction_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
