<Project Sdk="Microsoft.NET.Sdk">

  <!-- Creator's Bench media core: library index, metadata, safe renames, playlists, HTTP range logic.
       No WPF/WebView2 dependency, so it is unit-tested on any OS against real audio files. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NoorMD.Media</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="OggVorbisEncoder" Version="1.2.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoorMD.Media.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoorMD.Core\NoorMD.Core.csproj" />
  </ItemGroup>

</Project>
